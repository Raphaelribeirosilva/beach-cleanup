# Outside Git: /etc/beachcleanup/operations.env, owner root, mode 0600.
BACKUP_CLIENT_CONFIG=/etc/beachcleanup/backup.cnf
BACKUP_DIRECTORY=/var/backups/beachcleanup
BACKUP_DATABASE=beachcleanup_staging
# Must be an actual mount point backed by protected storage OUTSIDE the application VM.
BACKUP_OFFSITE_DIRECTORY=/mnt/beachcleanup-offsite
BACKUP_RETENTION_DAYS=14
RESTORE_CLIENT_CONFIG=/etc/beachcleanup/restore.cnf
RESTORE_REPORT_DIRECTORY=/var/backups/beachcleanup/restore-reports
