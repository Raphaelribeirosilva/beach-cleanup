# Copy values into Render Environment; never commit a filled-in copy.
SPRING_PROFILES_ACTIVE=prod,render
DB_HOST=replace-with-service-host.aivencloud.com
DB_PORT=replace-with-aiven-port
DB_NAME=defaultdb
DB_USER=replace-with-aiven-user
DB_PASSWORD=replace-in-dashboard
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
BREVO_API_KEY=replace-in-dashboard
ACCOUNT_MAIL_FROM=replace-with-verified-sender
ACCOUNT_PUBLIC_BASE_URL=https://replace-with-service-name.onrender.com
PUBLIC_ACCESS_ENABLED=false
MAIL_DELIVERY_VALIDATED=false
# PORT is provided by Render. Do not set DB_URL or a Gmail profile.
# Upload the Aiven project CA as Secret File aiven-ca.pem.
