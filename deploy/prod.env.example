# Configure these variables in the process manager, outside the Git repository.
# Java does not load this file automatically.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/beachcleanup
DB_USER=replace-with-database-account
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-persistent-base64-key-of-at-least-32-random-bytes
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
