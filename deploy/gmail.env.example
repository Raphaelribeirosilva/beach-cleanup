# Configure in Eclipse Run Configurations > Environment or the process manager.
# Do not save actual credentials in this example or send them through chat.
SPRING_PROFILES_ACTIVE=mysql,gmail-local
GMAIL_USERNAME=replace-with-your-sender@gmail.com
GMAIL_APP_PASSWORD=replace-with-google-app-password
# Keep the current DB_URL, DB_USER, DB_PASSWORD and persistent JWT_SECRET.
# gmail-local uses http://localhost:8080 by default and binds to 127.0.0.1.
# For hosting: profiles prod,gmail with ACCOUNT_PUBLIC_BASE_URL=https://YOUR_DOMAIN.
# Keep public access false until real delivery and acceptance have been verified.
